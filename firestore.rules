rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Reusable Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMonthKey(monthKey) {
      return monthKey is string && monthKey.size() == 7 && monthKey.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPlant(data, userId, plantId) {
      return data.keys().hasAll([
        'id', 'ownerId', 'name', 'speciesId', 'speciesName', 'entryType',
        'quantity', 'potMaterial', 'potSize', 'baseWaterDays', 'latestLux',
        'luxSource', 'lastLuxAt', 'lastWateredAt', 'notes', 'photoDataUrl',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'ownerId', 'name', 'speciesId', 'speciesName', 'botanicalName',
        'careDetails', 'idealLuxMin', 'idealLuxMax', 'sourceTitle', 'sourceUrl',
        'entryType', 'quantity', 'potMaterial', 'potSize', 'baseWaterDays',
        'latestLux', 'avgLux', 'luxReadingCount', 'lastLuxMonth',
        'luxSource', 'lastLuxAt', 'lastWateredAt', 'snoozedUntilAt', 'dampSnoozeCount', 'notes',
        'photoDataUrl', 'createdAt', 'updatedAt'
      ])
      && data.id is string && data.id == plantId && isValidId(data.id)
      && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
      && data.speciesId is string && data.speciesId.size() >= 1 && data.speciesId.size() <= 64 && data.speciesId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.speciesName is string && data.speciesName.size() >= 1 && data.speciesName.size() <= 80
      && (!('botanicalName' in data) || (data.botanicalName is string && data.botanicalName.size() <= 100))
      && (!('careDetails' in data) || (data.careDetails is string && data.careDetails.size() <= 800))
      && (!('idealLuxMin' in data) || (data.idealLuxMin is number && data.idealLuxMin >= 0 && data.idealLuxMin <= 150000))
      && (!('idealLuxMax' in data) || (data.idealLuxMax is number && data.idealLuxMax >= 0 && data.idealLuxMax <= 150000))
      && (!('sourceTitle' in data) || (data.sourceTitle is string && data.sourceTitle.size() <= 120))
      && (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 400 && (data.sourceUrl == '' || data.sourceUrl.matches('^https?://.*'))))
      && data.entryType is string && data.entryType in ['individual', 'group']
      && data.quantity is int && (
        (data.entryType == 'individual' && data.quantity == 1) ||
        (data.entryType == 'group' && data.quantity >= 2 && data.quantity <= 200)
      )
      && data.potMaterial is string && data.potMaterial in ['terracotta', 'ceramic', 'plastic']
      && data.potSize is string && data.potSize in ['small', 'medium', 'large']
      && data.baseWaterDays is number && data.baseWaterDays >= 1 && data.baseWaterDays <= 90
      && data.latestLux is number && data.latestLux >= 0 && data.latestLux <= 150000
      && (!('avgLux' in data) || (data.avgLux is number && data.avgLux >= 0 && data.avgLux <= 150000))
      && (!('luxReadingCount' in data) || (data.luxReadingCount is int && data.luxReadingCount >= 0 && data.luxReadingCount <= 10000))
      && (!('lastLuxMonth' in data) || (data.lastLuxMonth is string && data.lastLuxMonth.size() <= 10 && (data.lastLuxMonth == '' || data.lastLuxMonth.matches('^[0-9]{4}-[0-9]{2}$'))))
      && data.luxSource is string && data.luxSource in ['sensor', 'camera', 'manual']
      && data.lastLuxAt is string && data.lastLuxAt.size() >= 10 && data.lastLuxAt.size() <= 40
      && data.lastWateredAt is string && data.lastWateredAt.size() >= 10 && data.lastWateredAt.size() <= 40
      && (!('snoozedUntilAt' in data) || (data.snoozedUntilAt is string && data.snoozedUntilAt.size() <= 40 && (data.snoozedUntilAt == '' || data.snoozedUntilAt.size() >= 10)))
      && (!('dampSnoozeCount' in data) || (data.dampSnoozeCount is int && data.dampSnoozeCount >= 0 && data.dampSnoozeCount <= 1000))
      && data.notes is string && data.notes.size() <= 300
      && data.photoDataUrl is string && data.photoDataUrl.size() <= 180000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidPlantLog(data, userId, plantId, logId) {
      return data.keys().hasAll([
        'id', 'ownerId', 'plantId', 'logType', 'luxValue', 'luxSource',
        'note', 'recordedAt', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'ownerId', 'plantId', 'logType', 'luxValue', 'luxSource',
        'readingPeriod', 'note', 'recordedAt', 'createdAt'
      ])
      && data.id is string && data.id == logId && isValidId(data.id)
      && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
      && data.plantId is string && data.plantId == plantId && isValidId(data.plantId)
      && data.logType is string && data.logType in ['water', 'lux', 'snooze']
      && data.luxValue is number && data.luxValue >= 0 && data.luxValue <= 150000
      && data.luxSource is string && data.luxSource in ['sensor', 'camera', 'manual', 'none']
      && (!('readingPeriod' in data) || (data.readingPeriod is string && data.readingPeriod in ['peak_noon', 'general', 'none']))
      && data.note is string && data.note.size() <= 160
      && data.recordedAt is string && data.recordedAt.size() >= 10 && data.recordedAt.size() <= 40
      && data.createdAt is timestamp;
    }

    function isValidGrowthPhoto(data, userId, plantId, photoId) {
      return data.keys().hasAll([
        'id', 'ownerId', 'plantId', 'photoDataUrl', 'healthStatus',
        'growthSummary', 'issueDetected', 'recommendedAction',
        'avgLuxSnapshot', 'recordedAt', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'ownerId', 'plantId', 'photoDataUrl', 'healthStatus',
        'growthSummary', 'issueDetected', 'recommendedAction',
        'avgLuxSnapshot', 'recordedAt', 'createdAt'
      ])
      && data.id is string && data.id == photoId && isValidId(data.id)
      && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
      && data.plantId is string && data.plantId == plantId && isValidId(data.plantId)
      && data.photoDataUrl is string && data.photoDataUrl.size() >= 10 && data.photoDataUrl.size() <= 180000
      && data.healthStatus is string && data.healthStatus in ['thriving', 'watch', 'issue']
      && data.growthSummary is string && data.growthSummary.size() >= 1 && data.growthSummary.size() <= 300
      && data.issueDetected is string && data.issueDetected.size() <= 300
      && data.recommendedAction is string && data.recommendedAction.size() <= 400
      && data.avgLuxSnapshot is number && data.avgLuxSnapshot >= 0 && data.avgLuxSnapshot <= 150000
      && data.recordedAt is string && data.recordedAt.size() >= 10 && data.recordedAt.size() <= 40
      && data.createdAt is timestamp;
    }

    function isValidMonthlyTemp(data, userId, monthId) {
      return data.keys().hasAll([
        'id', 'ownerId', 'monthKey', 'avgTempC', 'minTempC', 'maxTempC',
        'humidityPct', 'heatingOrAc', 'note', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'ownerId', 'monthKey', 'avgTempC', 'minTempC', 'maxTempC',
        'humidityPct', 'heatingOrAc', 'daylightHours', 'note', 'createdAt', 'updatedAt'
      ])
      && data.id is string && data.id == monthId && isValidMonthKey(data.id)
      && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
      && data.monthKey is string && data.monthKey == monthId && isValidMonthKey(data.monthKey)
      && data.avgTempC is number && data.avgTempC >= 5 && data.avgTempC <= 42
      && data.minTempC is number && data.minTempC >= 0 && data.minTempC <= 40
      && data.maxTempC is number && data.maxTempC >= 5 && data.maxTempC <= 45
      && data.minTempC <= data.avgTempC && data.avgTempC <= data.maxTempC
      && data.humidityPct is number && data.humidityPct >= 15 && data.humidityPct <= 95
      && data.heatingOrAc is string && data.heatingOrAc in ['none', 'heating', 'ac', 'natural_vent']
      && (!('daylightHours' in data) || (data.daylightHours is number && data.daylightHours >= 0.5 && data.daylightHours <= 18))
      && data.note is string && data.note.size() <= 200
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Plants collection (individual plants and same-species groups)
    match /users/{userId}/plants/{plantId} {
      allow get: if isOwner(userId) && isValidId(plantId) && existing().ownerId == request.auth.uid;
      allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isOwner(userId)
        && isValidId(plantId)
        && isValidPlant(incoming(), userId, plantId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(plantId)
        && isValidPlant(incoming(), userId, plantId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Quick Water Now
          incoming().diff(existing()).affectedKeys().hasOnly(['lastWateredAt', 'snoozedUntilAt', 'updatedAt']) ||
          // Action 2: Record Lux Measurement & Rolling Average
          incoming().diff(existing()).affectedKeys().hasOnly([
            'latestLux', 'avgLux', 'luxReadingCount', 'lastLuxMonth',
            'luxSource', 'lastLuxAt', 'updatedAt'
          ]) ||
          // Action 3: Update Photo & Web Lookup Care Details
          incoming().diff(existing()).affectedKeys().hasOnly([
            'photoDataUrl', 'speciesId', 'speciesName', 'botanicalName',
            'careDetails', 'idealLuxMin', 'idealLuxMax', 'baseWaterDays',
            'sourceTitle', 'sourceUrl', 'updatedAt'
          ]) ||
          // Action 4: Edit Plant / Group Details
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'speciesId', 'speciesName', 'botanicalName', 'careDetails',
            'idealLuxMin', 'idealLuxMax', 'sourceTitle', 'sourceUrl',
            'entryType', 'quantity', 'potMaterial', 'potSize', 'baseWaterDays',
            'latestLux', 'avgLux', 'luxReadingCount', 'lastLuxMonth',
            'luxSource', 'lastLuxAt', 'lastWateredAt', 'snoozedUntilAt',
            'dampSnoozeCount', 'notes', 'photoDataUrl', 'updatedAt'
          ]) ||
          // Action 5: Still Damp (+2d) Snooze & Smart Interval Calibration
          incoming().diff(existing()).affectedKeys().hasOnly([
            'snoozedUntilAt', 'baseWaterDays', 'dampSnoozeCount', 'updatedAt'
          ])
        );
      allow delete: if isOwner(userId) && isValidId(plantId) && existing().ownerId == request.auth.uid;

      // Subcollection: Watering & Lux Logs (Master Gate pattern)
      match /logs/{logId} {
        allow get: if isOwner(userId)
          && isValidId(plantId)
          && isValidId(logId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)/plants/$(plantId)).data.ownerId == request.auth.uid;
        allow list: if isOwner(userId) && isValidId(plantId) && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(plantId)
          && isValidId(logId)
          && isValidPlantLog(incoming(), userId, plantId, logId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/plants/$(plantId))
          && get(/databases/$(database)/documents/users/$(userId)/plants/$(plantId)).data.ownerId == request.auth.uid;
        allow update: if false;
        allow delete: if isOwner(userId)
          && isValidId(plantId)
          && isValidId(logId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)/plants/$(plantId)).data.ownerId == request.auth.uid;
      }

      // Subcollection: Growth Timeline Photos (Master Gate pattern)
      match /growthPhotos/{photoId} {
        allow get: if isOwner(userId)
          && isValidId(plantId)
          && isValidId(photoId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)/plants/$(plantId)).data.ownerId == request.auth.uid;
        allow list: if isOwner(userId) && isValidId(plantId) && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(plantId)
          && isValidId(photoId)
          && isValidGrowthPhoto(incoming(), userId, plantId, photoId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/plants/$(plantId))
          && get(/databases/$(database)/documents/users/$(userId)/plants/$(plantId)).data.ownerId == request.auth.uid;
        allow update: if false;
        allow delete: if isOwner(userId)
          && isValidId(plantId)
          && isValidId(photoId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)/plants/$(plantId)).data.ownerId == request.auth.uid;
      }
    }

    // Monthly Barcelona Room Temperature Logs
    match /users/{userId}/monthlyTemps/{monthId} {
      allow get: if isOwner(userId) && isValidMonthKey(monthId) && existing().ownerId == request.auth.uid;
      allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isOwner(userId)
        && isValidMonthKey(monthId)
        && isValidMonthlyTemp(incoming(), userId, monthId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidMonthKey(monthId)
        && isValidMonthlyTemp(incoming(), userId, monthId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().monthKey == existing().monthKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'avgTempC', 'minTempC', 'maxTempC', 'humidityPct',
          'heatingOrAc', 'daylightHours', 'note', 'updatedAt'
        ]);
      allow delete: if isOwner(userId) && isValidMonthKey(monthId) && existing().ownerId == request.auth.uid;
    }
  }
}
